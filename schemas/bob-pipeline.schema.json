{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bob-pipeline configuration",
  "type": "object",
  "required": [
    "version",
    "project_name",
    "stack",
    "roles",
    "tools",
    "human_gates",
    "thresholds",
    "send_back_routes",
    "return_limit",
    "parallel_limit",
    "night_mode_default"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "human_gates": {
      "type": "object",
      "required": [
        "gherkin_approval",
        "final_qa_report"
      ],
      "additionalProperties": false,
      "properties": {
        "gherkin_approval": {
          "type": "boolean"
        },
        "final_qa_report": {
          "type": "boolean"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "mutation_score_min",
        "coverage_policy",
        "complexity_policy",
        "duplication_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "mutation_score_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_policy": {
          "type": "string",
          "enum": [
            "informational"
          ]
        },
        "complexity_policy": {
          "type": "string",
          "enum": [
            "not-worse-than-baseline",
            "off"
          ]
        },
        "duplication_policy": {
          "type": "string",
          "enum": [
            "not-worse-than-baseline",
            "off"
          ]
        }
      }
    },
    "send_back_routes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/roleName"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/roleName"
            },
            "minItems": 1
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "specifier",
          "coder",
          "cleaner",
          "architect",
          "hardener",
          "qa"
        ]
      }
    },
    "return_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "parallel_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "quality_gates": {
      "description": "Quality gates (D20); enabled by default. Per-gate override via gates.<name>: false.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "diff_coverage_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lint": {
              "type": "boolean"
            },
            "format": {
              "type": "boolean"
            },
            "architecture": {
              "type": "boolean"
            },
            "diff-coverage": {
              "type": "boolean"
            },
            "constitution-traceability": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "mutation": {
      "description": "Mutation frameworks run only when framework_enabled is true (D22); the hardener is semantic by default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardener_qa": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "bdd_framework": {
      "type": "string",
      "enum": [
        "reqnroll",
        "cucumber-js",
        "behave"
      ]
    },
    "night_mode_default": {
      "type": "boolean"
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only reconnaissance pass before the coder's first attempt on a slice (D25).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false disables the scout pass entirely."
        },
        "model": {
          "type": "string",
          "default": "haiku",
          "description": "Model the scout is spawned with."
        }
      }
    }
  },
  "$defs": {
    "roleName": {
      "description": "'cleaner' is deprecated (merged into architect); accepted with a validator warning. Role defaults live in templates/bob-pipeline.yaml.",
      "type": "string",
      "enum": [
        "specifier",
        "coder",
        "cleaner",
        "architect",
        "hardener",
        "qa"
      ]
    },
    "tests": {
      "description": "Test commands; per-stack defaults live in templates/bob-pipeline.yaml.",
      "type": "object",
      "required": [
        "run_command"
      ],
      "additionalProperties": false,
      "properties": {
        "warmup_command": {
          "description": "Warm-up command, run ONCE when a slice worktree is created (restore/install); after it all other test commands run without package restore.",
          "type": "string",
          "minLength": 1
        },
        "run_command": {
          "type": "string",
          "minLength": 1
        },
        "scoped_command": {
          "type": "string",
          "pattern": "[{]filter[}]"
        },
        "coverage_command": {
          "type": "string",
          "minLength": 1
        },
        "integration_command": {
          "type": "string",
          "minLength": 1
        },
        "integration_at": {
          "type": "string",
          "enum": [
            "merge-gate",
            "run-end"
          ]
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "name",
        "model",
        "enabled",
        "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/roleName"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tests-green",
              "mutation-score",
              "hardening-findings",
              "complexity-baseline",
              "duplication-baseline",
              "gherkin-traceability",
              "lint",
              "format",
              "architecture",
              "diff-coverage",
              "constitution-traceability"
            ]
          }
        },
        "degradation": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "stack",
        "category",
        "tool",
        "run_command",
        "report_parser",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "mutation",
            "coverage",
            "complexity",
            "duplication",
            "lint",
            "format",
            "architecture",
            "diff-coverage",
            "constitution-traceability"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "run_command": {
          "type": "string",
          "minLength": 1
        },
        "report_parser": {
          "type": "string",
          "minLength": 1
        },
        "scope_flag": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
