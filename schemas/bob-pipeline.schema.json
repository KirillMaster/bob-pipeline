{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bob-pipeline configuration",
  "type": "object",
  "required": [
    "version",
    "project_name",
    "stack",
    "roles",
    "tools",
    "human_gates",
    "thresholds",
    "send_back_routes",
    "return_limit",
    "parallel_limit",
    "night_mode_default"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "human_gates": {
      "type": "object",
      "required": [
        "gherkin_approval",
        "final_qa_report"
      ],
      "additionalProperties": false,
      "properties": {
        "gherkin_approval": {
          "type": "boolean"
        },
        "final_qa_report": {
          "type": "boolean"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": [
        "mutation_score_min",
        "coverage_policy",
        "complexity_policy",
        "duplication_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "mutation_score_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_policy": {
          "type": "string",
          "enum": [
            "informational"
          ]
        },
        "complexity_policy": {
          "type": "string",
          "enum": [
            "not-worse-than-baseline",
            "off"
          ]
        },
        "duplication_policy": {
          "type": "string",
          "enum": [
            "not-worse-than-baseline",
            "off"
          ]
        }
      }
    },
    "send_back_routes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/roleName"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/roleName"
            },
            "minItems": 1
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "specifier",
          "coder",
          "cleaner",
          "architect",
          "hardener",
          "qa"
        ]
      }
    },
    "return_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "parallel_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "quality_gates": {
      "description": "Quality gates (D20); enabled by default. Per-gate override via gates.<name>: false.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "diff_coverage_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lint": {
              "type": "boolean"
            },
            "format": {
              "type": "boolean"
            },
            "architecture": {
              "type": "boolean"
            },
            "diff-coverage": {
              "type": "boolean"
            },
            "constitution-traceability": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "mutation": {
      "description": "Mutation frameworks run only when framework_enabled is true (D22); the hardener is semantic by default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardener_qa": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "bdd_framework": {
      "type": "string",
      "enum": [
        "reqnroll",
        "cucumber-js",
        "behave"
      ]
    },
    "night_mode_default": {
      "type": "boolean"
    },
    "plan_conformance": {
      "description": "Plan-conformance gate (1.8.0): the coder's diff must stay inside the Specifier's slice manifest (scripts/plan_conformance.py).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "protected_paths": {
          "description": "Extra globs the coder must never touch (arch layout files etc.); baselines, bob config/agents/state are always protected.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "test_paths": {
          "description": "Globs of test files whose types need no new_types entry (default: common tests/ dirs and *Tests.cs, *.test.*, *.spec.*, test_*.py).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "module_paths": {
          "description": "Module name -> globs where its new types may live.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "edge_check_command": {
          "description": "Optional command run in the slice worktree (e.g. architecture tests); non-zero exit fails the gate.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bugfix": {
      "description": "KISS gates for a `bugfix` run kind (1.9.0): scripts/bugfix_gates.py (K1-K5, K7, K8, K2/K3 with --run-tests) and bugfix_ablation.py (K6).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_added_lines": { "type": "integer", "minimum": 1, "default": 30 },
        "max_files": { "type": "integer", "minimum": 1, "default": 2 },
        "max_complexity_delta": { "description": "K8: allowed growth of decision points per changed production file.", "type": "integer", "minimum": 0, "default": 3 },
        "max_nesting_delta": { "description": "K8: allowed growth of max indentation depth per changed production file.", "type": "integer", "minimum": 0, "default": 1 },
        "runs": { "description": "Repeats of the regression test on head and on the reverted base (flake guard).", "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "test_command": { "description": "Runs the regression test; {tests} = its paths, {filter} = dotnet FullyQualifiedName filter of the added test methods.", "type": "string", "minLength": 1 },
        "ablation": { "description": "K6 hunk ablation: off, warn (reported, gate passes) or hard.", "type": "string", "enum": ["off", "warn", "hard"], "default": "warn" }
      }
    },
    "tidy_first": {
      "description": "Tidy First split (1.9.0, E1 + Z16): structural commits must not touch test assertions or add tests (scripts/tidy_first.py).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "structural_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "default": ["tidy", "refactor", "structural", "style", "format"]
        }
      }
    },
    "pr_description": {
      "description": "PR body from the slice manifest (1.9.0, E3 + E4): scripts/pr_description.py.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "require_purpose": { "description": "Every new_types entry needs a purpose sentence.", "type": "boolean", "default": true }
      }
    },
    "adr": {
      "description": "ADR required gate (1.9.0, G1): a slice with a new interface or module edge needs an ADR (scripts/adr_gate.py).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "required": { "type": "boolean", "default": true },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "default": ["docs/adr/**", "docs/decisions/**"] }
      }
    },
    "escalation": {
      "description": "After max_red_iterations consecutive red gate iterations the slice leaves the coder loop (1.8.0).",
      "type": "object",
      "required": ["max_red_iterations", "on_exhaust"],
      "additionalProperties": false,
      "properties": {
        "max_red_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "on_exhaust": {
          "description": "specifier = send the slice back to the Specifier (plan infeasible + gate report); stronger_model = retry the Coder on escalation_model.",
          "type": "string",
          "enum": ["specifier", "stronger_model"]
        },
        "escalation_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only reconnaissance pass before the coder's first attempt on a slice (D25).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false disables the scout pass entirely."
        },
        "model": {
          "type": "string",
          "default": "haiku",
          "description": "Model the scout is spawned with."
        }
      }
    }
  },
  "$defs": {
    "roleName": {
      "description": "'cleaner' is deprecated (merged into architect); accepted with a validator warning. Role defaults live in templates/bob-pipeline.yaml.",
      "type": "string",
      "enum": [
        "specifier",
        "coder",
        "cleaner",
        "architect",
        "hardener",
        "qa"
      ]
    },
    "tests": {
      "description": "Test commands; per-stack defaults live in templates/bob-pipeline.yaml.",
      "type": "object",
      "required": [
        "run_command"
      ],
      "additionalProperties": false,
      "properties": {
        "warmup_command": {
          "description": "Warm-up command, run ONCE when a slice worktree is created (restore/install); after it all other test commands run without package restore.",
          "type": "string",
          "minLength": 1
        },
        "run_command": {
          "type": "string",
          "minLength": 1
        },
        "scoped_command": {
          "type": "string",
          "pattern": "[{]filter[}]"
        },
        "coverage_command": {
          "type": "string",
          "minLength": 1
        },
        "integration_command": {
          "type": "string",
          "minLength": 1
        },
        "integration_at": {
          "type": "string",
          "enum": [
            "merge-gate",
            "run-end"
          ]
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "name",
        "model",
        "enabled",
        "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/roleName"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tests-green",
              "mutation-score",
              "hardening-findings",
              "complexity-baseline",
              "duplication-baseline",
              "gherkin-traceability",
              "lint",
              "format",
              "architecture",
              "diff-coverage",
              "constitution-traceability",
              "plan-conformance",
              "bugfix",
              "tidy-first",
              "adr"
            ]
          }
        },
        "degradation": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "stack",
        "category",
        "tool",
        "run_command",
        "report_parser",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "mutation",
            "coverage",
            "complexity",
            "duplication",
            "lint",
            "format",
            "architecture",
            "diff-coverage",
            "constitution-traceability"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "run_command": {
          "type": "string",
          "minLength": 1
        },
        "report_parser": {
          "type": "string",
          "minLength": 1
        },
        "scope_flag": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
