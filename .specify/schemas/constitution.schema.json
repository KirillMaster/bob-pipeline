{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit.local/schemas/constitution.schema.json",
  "title": "constitution.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_name", "version", "ratified", "last_amended", "principles"],
  "properties": {
    "project_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ratified": { "type": "string", "format": "date" },
    "last_amended": { "type": "string", "format": "date" },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "severity", "gate_condition"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["NON-NEGOTIABLE", "recommended"] },
          "gate_condition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
