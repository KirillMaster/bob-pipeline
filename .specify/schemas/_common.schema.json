{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit.local/schemas/_common.schema.json",
  "title": "Common sub-schemas shared by acceptance_criteria and test_scenarios across spec.yaml and tasks.yaml",
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "done"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "description": { "type": "string", "minLength": 1 },
        "done": { "type": "boolean" }
      }
    },
    "acceptanceCriteriaList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "testScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then", "verification", "level"],
      "properties": {
        "id": { "type": "string", "pattern": "^TS-[0-9]+$" },
        "given": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["manual", "automated"] },
          "uniqueItems": true
        },
        "level": {
          "type": "string",
          "enum": ["unit", "integration", "e2e"],
          "description": "Which test layer this scenario belongs to — routes automated verification to the right kind of test during implementation."
        },
        "automation_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the concrete automated test (file, and function/case name) once written. Absent until /speckit-implement creates it — never required at authoring time, since the test doesn't exist yet."
        }
      }
    },
    "testScenariosList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testScenario" }
    }
  }
}
